<Window
    x:Class="ProtectedApp.NoticeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ProtectedApp">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Background="Transparent" Padding="24" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
            <Grid x:Name="HeaderDragArea" Grid.ColumnSpan="2" ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource ControlSurfaceBrush}">
                    <FontIcon FontFamily="{StaticResource PrototypeIconFont}" Glyph="&#xf083;" Foreground="{ThemeResource WarningBrush}" FontSize="17" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource PrototypeSansFont}" x:Name="AppNameText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontFamily="{StaticResource PrototypeSansFont}" x:Name="SubtitleText" Text="Ejecución bloqueada" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" />
                </StackPanel>
            </Grid>
            <Button Grid.Column="2" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,2,2,0" Padding="0" CornerRadius="13" Background="{ThemeResource CloseButtonBrush}"
                    BorderThickness="0" Foreground="White" AutomationProperties.Name="Cerrar"
                    ToolTipService.ToolTip="Cerrar" Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseSurface" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="CloseSurface.Background" Value="{ThemeResource DangerBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="CloseSurface.Background" Value="{ThemeResource DangerPressedBrush}" /></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <FontIcon FontFamily="{StaticResource PrototypeIconFont}" Glyph="&#xe5cd;" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <TextBlock FontFamily="{StaticResource PrototypeSansFont}" x:Name="MessageText" Grid.Row="2" Foreground="{ThemeResource PrimaryTextBrush}"
                   FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />

        <Grid Grid.Row="4" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="ActionButton" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Stretch"
                    Style="{StaticResource RoundedDialogButtonStyle}" Click="ActionButton_Click" />
            <Button x:Name="AcceptButton" Grid.Column="1" Content="Entendido" HorizontalAlignment="Stretch"
                    Style="{StaticResource RoundedPrimaryButtonStyle}" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
