                    <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="ControlPressedBrush" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="FilterCardHoverBrush" Color="#D9EAF8" />
                    <SolidColorBrush x:Key="FilterCardPressedBrush" Color="#C2DDF2" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="AccentIndigoBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0258A8" />
                    <SolidColorBrush x:Key="AccentPressedBrush" Color="#004F98" />
                    <SolidColorBrush x:Key="ActiveIndicatorBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="PrimaryActionBrush" Color="#005FB8" />
