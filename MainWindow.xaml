                    </Grid>

                    <Grid x:Name="SettingsInformationSection" Visibility="Collapsed" Padding="2,10,8,8">
                        <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="CÓMO FUNCIONA PROTECTEDAPP" Foreground="{ThemeResource SubtleTextBrush}" FontSize="10" FontWeight="SemiBold" CharacterSpacing="70"/>
                                    <TextBlock Text="ProtectedApp reúne en un solo lugar la protección de aplicaciones y la creación de bóvedas cifradas para guardar información sensible." FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Las opciones se agrupan por finalidad para que puedas decidir qué proteger sin necesitar conocimientos técnicos." Foreground="{ThemeResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Aplicaciones protegidas" FontWeight="SemiBold"/>
                                        <TextBlock Text="Puedes pedir la contraseña maestra antes de abrir una aplicación elegida. También es posible cerrarla automáticamente tras un tiempo o después de un periodo sin actividad; si activas los avisos, ProtectedApp te avisará y permitirá ampliar ese tiempo." Foreground="{ThemeResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Bóvedas cifradas" FontWeight="SemiBold"/>
                                        <TextBlock Text="Una bóveda es un archivo .pavault que contiene tus archivos cifrados. Al abrirla con tu contraseña se monta como una unidad normal de Windows; al desmontarla, su contenido vuelve a quedar protegido dentro del archivo. Puedes convertir una carpeta existente en una bóveda y comprobar el resultado antes de eliminar la carpeta original." Foreground="{ThemeResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Copias y recuperación" FontWeight="SemiBold"/>
                                        <TextBlock Text="Puedes exportar una copia cifrada de la configuración y programar copias de tus bóvedas. Los avisos de bóvedas informan cuando una copia falla, vence o se recupera. Para mantener una bóveda sincronizada con OneDrive u otro servicio similar, sincroniza el archivo .pavault, no una carpeta mientras está abierta." Foreground="{ThemeResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Guardian y seguridad" FontWeight="SemiBold"/>
                                        <TextBlock Text="El servicio Guardian comprueba que los componentes de protección estén disponibles y avisa si detecta un problema o una posible manipulación. Las alertas remotas son opcionales y solo envían un aviso a la dirección configurada; no conceden acceso a tus datos." Foreground="{ThemeResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Background="{ThemeResource ControlSurfaceBrush}" CornerRadius="8" Padding="12,10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="RECOMENDACIÓN" Foreground="{ThemeResource AccentIndigoBrush}" FontSize="10" FontWeight="SemiBold" CharacterSpacing="50"/>
                                        <TextBlock Text="Conserva una copia de seguridad de las bóvedas importantes y no olvides la contraseña maestra: está diseñada para proteger tu información, por lo que ProtectedApp no puede recuperarla por ti." Foreground="{ThemeResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
