                    <SolidColorBrush x:Key="PrimaryActionPressedBrush" Color="#004F98" />
                    <SolidColorBrush x:Key="PrimaryActionTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#3B3B3B" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#3B3B3B" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#767676" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#2EA043" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#895503" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#F85149" />
                    <SolidColorBrush x:Key="DangerPressedBrush" Color="#C72E0F" />
                    <SolidColorBrush x:Key="CloseButtonBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="ContentDialogForeground" Color="#3B3B3B" />
                    <AcrylicBrush x:Key="ContentDialogBackground"
                                  TintColor="#F8FAFC" TintOpacity="0.46" FallbackColor="#C8F8FAFC"
                                  AlwaysUseFallback="False" />
                    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#00F8F8F8" />
                    <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#28000000" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
