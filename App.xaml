                    <SolidColorBrush x:Key="TextControlHeaderForegroundDisabled" Color="#767676" />
                    <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="#CCCCCC" />
