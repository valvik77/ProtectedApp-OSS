                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#005FB8" />
                    <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#E8E8E8" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#DCDCDC" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="ListViewItemForeground" Color="#3B3B3B" />
                    <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#000000" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#000000" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#000000" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="#000000" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#0258A8" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#004F98" />
                    <SolidColorBrush x:Key="TabViewButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewButtonBackgroundPointerOver" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="TabViewButtonBackgroundPressed" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#FFFFFF" />
