                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#767676" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#767676" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#A0A0A0" />
