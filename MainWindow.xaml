                                    <Grid Padding="0,8" ColumnSpacing="10" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="Avisos de cierre automático" FontWeight="SemiBold"/><TextBlock Text="Permite avisar y ampliar los cierres por tiempo o inactividad." Foreground="{ThemeResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Style="{StaticResource TruncatedTextStyle}"/></StackPanel><ToggleSwitch x:Name="CloseWarningNotificationsToggle" Grid.Column="1" Toggled="CloseWarningNotificationsToggle_Toggled"/></Grid>
