                                    <Grid Padding="0,8" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="Desinstalar" FontWeight="SemiBold"/><TextBlock Text="Requiere la contraseña maestra." Foreground="{ThemeResource MutedTextBrush}" FontSize="12"/></StackPanel><Button Grid.Column="1" Width="150" Content="Desinstalar…" Style="{StaticResource RoundedDialogButtonStyle}" Foreground="{ThemeResource DangerBrush}" CornerRadius="8" Click="Uninstall_Click"/></Grid>
