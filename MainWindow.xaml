<Window
    x:Class="ProtectedApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ProtectedApp.Converters"
    xmlns:models="using:ProtectedApp.Models"
    xmlns:services="using:ProtectedApp.Services"
    Title="ProtectedApp">
    <Window.SystemBackdrop><DesktopAcrylicBackdrop /></Window.SystemBackdrop>

    <Grid x:Name="Root" Background="Transparent">
        <Grid.Resources>
            <converters:ActivityKindBrushConverter x:Key="ActivityKindBrushConverter"/>
            <Style x:Key="TruncatedTextStyle" TargetType="TextBlock">
                <Setter Property="services:TruncatedTextToolTip.Enabled" Value="True"/>
            </Style>
            <DataTemplate x:Key="InstalledAppTemplate">
                <Grid Padding="8,7" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="7" Background="{ThemeResource ControlSurfaceBrush}">
                        <Image Source="{Binding IconSource}" Stretch="Uniform" Margin="5"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Style="{StaticResource TruncatedTextStyle}"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource SubtleTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Style="{StaticResource TruncatedTextStyle}"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <Style x:Key="NavStyle" TargetType="Button">
                <Setter Property="Height" Value="42"/>
                <Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="12,0"/>
                <Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedDialogButtonStyle}">
                <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="7"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}"/><Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="{ThemeResource SidebarAcrylicBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{ThemeResource ControlSurfaceBrush}">
                        <Image Source="Assets/BrandShield.png" Stretch="Uniform" Margin="4"/>
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="ProtectedApp" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="Protección local" Foreground="{ThemeResource SubtleTextBrush}" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="ESPACIO DE TRABAJO" Foreground="{ThemeResource SubtleTextBrush}" FontSize="9" FontWeight="SemiBold" CharacterSpacing="80" Margin="10,0,0,8"/>
                    <Button x:Name="DashboardNavButton" AutomationProperties.Name="Inicio" Style="{StaticResource NavStyle}" Tag="dashboard" Click="NavButton_Click" ToolTipService.ToolTip="Resumen de protección">
                        <StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="15"/><TextBlock Text="Inicio" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button x:Name="AppsNavButton" AutomationProperties.Name="Aplicaciones" Style="{StaticResource NavStyle}" Tag="apps" Click="NavButton_Click" ToolTipService.ToolTip="Aplicaciones protegidas">
                        <StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE71D;" FontFamily="Segoe Fluent Icons" FontSize="15"/><TextBlock Text="Aplicaciones" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button x:Name="VaultsNavButton" AutomationProperties.Name="Bóvedas" Style="{StaticResource NavStyle}" Tag="vaults" Click="NavButton_Click" ToolTipService.ToolTip="Bóvedas cifradas">
                        <StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="15"/><TextBlock Text="Bóvedas" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button x:Name="ActivityNavButton" AutomationProperties.Name="Actividad" Style="{StaticResource NavStyle}" Tag="activity" Click="NavButton_Click" ToolTipService.ToolTip="Actividad">
                        <StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="15"/><TextBlock Text="Actividad" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button x:Name="DiagnosticsNavButton" AutomationProperties.Name="Diagnóstico" Style="{StaticResource NavStyle}" Tag="diagnostics" Click="NavButton_Click" ToolTipService.ToolTip="Diagnóstico">
                        <StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE9D2;" FontFamily="Segoe Fluent Icons" FontSize="15"/><TextBlock Text="Diagnóstico" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button x:Name="SettingsNavButton" AutomationProperties.Name="Configuración" Style="{StaticResource NavStyle}" Tag="settings" Click="NavButton_Click" ToolTipService.ToolTip="Configuración">
                        <StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15"/><TextBlock Text="Configuración" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button x:Name="AboutNavButton" AutomationProperties.Name="Acerca de" Style="{StaticResource NavStyle}" Tag="about" Click="NavButton_Click" ToolTipService.ToolTip="Acerca de ProtectedApp">
                        <StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="15"/><TextBlock Text="Acerca de" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="10">
                    <Button Style="{StaticResource RoundedDialogButtonStyle}" Background="#B42318" BorderBrush="#B42318" Foreground="White" Click="LockButton_Click"
                            AutomationProperties.Name="Bloqueo inmediato" ToolTipService.ToolTip="Revocar accesos y bloquear ahora">
                        <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE72E;" FontSize="14"/><TextBlock Text="Bloqueo inmediato" FontWeight="SemiBold" FontSize="12"/></StackPanel>
                    </Button>
                    <Border Background="{ThemeResource ControlSurfaceBrush}" CornerRadius="8" Padding="10,8">
                        <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse x:Name="SidebarStatusDot" Width="7" Height="7" Fill="{ThemeResource SuccessBrush}" VerticalAlignment="Center"/><TextBlock x:Name="SidebarStatusText" Text="Guardian conectado" FontSize="10" Foreground="{ThemeResource MutedTextBrush}"/></StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Grid.RowSpan="2" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"/>

        <Grid Grid.Column="1" Padding="20,0,16,0" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid x:Name="TitleDragRegion" Background="Transparent">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="PageTitle" Text="Aplicaciones" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageSubtitle" Text="Elige qué programas requieren autorización" Foreground="{ThemeResource MutedTextBrush}" FontSize="11"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2" Padding="3"
                            Background="{ThemeResource ControlSurfaceBrush}" CornerRadius="8"
                            AutomationProperties.Name="Tema de la aplicación">
                    <Button x:Name="ThemeLightButton" Tag="light" Content="&#xE706;" Style="{StaticResource IconButtonStyle}"
                            Click="ThemeButton_Click" ToolTipService.ToolTip="Usar modo claro"
                            AutomationProperties.Name="Usar modo claro"/>
                    <Button x:Name="ThemeSystemButton" Tag="system" Content="&#xE7F4;" Style="{StaticResource IconButtonStyle}"
                            Click="ThemeButton_Click" ToolTipService.ToolTip="Seguir el tema de Windows"
                            AutomationProperties.Name="Seguir el tema de Windows"/>
                    <Button x:Name="ThemeDarkButton" Tag="dark" Content="&#xE708;" Style="{StaticResource IconButtonStyle}"
                            Click="ThemeButton_Click" ToolTipService.ToolTip="Usar modo oscuro"
                            AutomationProperties.Name="Usar modo oscuro"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{ThemeResource SuccessBrush}"/>
                    <TextBlock x:Name="StatusText" Text="Activa" Foreground="{ThemeResource MutedTextBrush}" FontSize="11"/>
                </StackPanel>
                <Button Height="34"
                        Style="{StaticResource RoundedDialogButtonStyle}"
                        Padding="11,0"
                        CornerRadius="8"
                        Background="{ThemeResource ControlSurfaceBrush}"
                        BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1"
                        Click="LockButton_Click"
                        AutomationProperties.Name="Bloquear ahora"
                        ToolTipService.ToolTip="Revocar accesos y cerrar las aplicaciones protegidas">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                        <TextBlock Text="Bloquear" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PauseButton" Style="{StaticResource IconButtonStyle}" Click="PauseButton_Click" ToolTipService.ToolTip="Pausar protección" AutomationProperties.Name="Pausar protección" Visibility="Collapsed">
                    <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="13"/>
                </Button>
            </StackPanel>
            <Button Grid.Column="3"
                    Width="28" Height="28"
                    Padding="0"
                    CornerRadius="14"
                    Background="{ThemeResource ControlSurfaceBrush}"
                    BorderThickness="0"
                    Foreground="{ThemeResource PrimaryTextBrush}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Minimizar"
                    ToolTipService.ToolTip="Minimizar a la barra de tareas"
                    Click="MainMinimizeButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MinimizeSurface"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters><Setter Target="MinimizeSurface.Background" Value="{ThemeResource ControlHoverBrush}"/></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters><Setter Target="MinimizeSurface.Opacity" Value="0.72"/></VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <FontIcon Glyph="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Grid.Column="5"
                    Width="28" Height="28"
                    Padding="0"
                    CornerRadius="14"
                    Background="{ThemeResource CloseButtonBrush}"
                    BorderThickness="0"
                    Foreground="White"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Cerrar"
                    ToolTipService.ToolTip="Ocultar ProtectedApp"
                    Click="MainCloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseSurface"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters><Setter Target="CloseSurface.Background" Value="{ThemeResource DangerBrush}"/></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters><Setter Target="CloseSurface.Background" Value="{ThemeResource DangerPressedBrush}"/></VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Auto" HorizontalScrollMode="Disabled" ZoomMode="Disabled">
        <Grid Margin="20,6,20,20" MinWidth="760">
            <Grid x:Name="DashboardView">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Padding="22,18" CornerRadius="14" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="7"><Border Background="{ThemeResource SuccessBrush}" CornerRadius="4" Padding="6,2"><TextBlock Text="PROTECCIÓN ACTIVA" Foreground="White" FontSize="9" FontWeight="SemiBold" CharacterSpacing="60"/></Border><TextBlock Text="Guardian" Foreground="{ThemeResource SubtleTextBrush}" FontSize="10" VerticalAlignment="Center"/></StackPanel>
                            <TextBlock Text="Centro de seguridad" FontSize="25" FontWeight="SemiBold"/>
                            <TextBlock Text="Consulta el estado de tus reglas, bóvedas y actividad reciente." Foreground="{ThemeResource MutedTextBrush}" FontSize="12"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{ThemeResource ControlSurfaceBrush}" CornerRadius="10" Padding="14,9" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SuccessBrush}" FontSize="17"/><StackPanel><TextBlock x:Name="DashboardGuardianText" Text="Guardian conectado" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="Protección administrada" Foreground="{ThemeResource SubtleTextBrush}" FontSize="10"/></StackPanel></StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Padding="15" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1"><StackPanel Spacing="5"><FontIcon Glyph="&#xE72E;" Foreground="{ThemeResource AccentIndigoBrush}" FontSize="16"/><TextBlock Text="REGLAS ACTIVAS" Foreground="{ThemeResource SubtleTextBrush}" FontSize="9" FontWeight="SemiBold" CharacterSpacing="60"/><TextBlock x:Name="DashboardAppsCountText" Text="0" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="DashboardAppsDetailText" Text="aplicaciones protegidas" Foreground="{ThemeResource MutedTextBrush}" FontSize="10"/></StackPanel></Border>
                    <Border Grid.Column="1" Padding="15" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1"><StackPanel Spacing="5"><FontIcon Glyph="&#xEDA2;" Foreground="{ThemeResource SuccessBrush}" FontSize="16"/><TextBlock Text="BÓVEDAS" Foreground="{ThemeResource SubtleTextBrush}" FontSize="9" FontWeight="SemiBold" CharacterSpacing="60"/><TextBlock x:Name="DashboardVaultCountText" Text="0" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="DashboardVaultDetailText" Text="contenedores cifrados" Foreground="{ThemeResource MutedTextBrush}" FontSize="10"/></StackPanel></Border>
                    <Border Grid.Column="2" Padding="15" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1"><StackPanel Spacing="5"><FontIcon Glyph="&#xE9D9;" Foreground="{ThemeResource WarningBrush}" FontSize="16"/><TextBlock Text="ACTIVIDAD · 24 H" Foreground="{ThemeResource SubtleTextBrush}" FontSize="9" FontWeight="SemiBold" CharacterSpacing="60"/><TextBlock x:Name="DashboardActivityCountText" Text="0" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="eventos registrados" Foreground="{ThemeResource MutedTextBrush}" FontSize="10"/></StackPanel></Border>
                    <Border Grid.Column="3" Padding="15" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1"><StackPanel Spacing="5"><FontIcon Glyph="&#xE9D2;" Foreground="{ThemeResource AccentIndigoBrush}" FontSize="16"/><TextBlock Text="INTEGRIDAD" Foreground="{ThemeResource SubtleTextBrush}" FontSize="9" FontWeight="SemiBold" CharacterSpacing="60"/><TextBlock x:Name="DashboardDiagnosticsText" Text="Pendiente" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="comprobación del sistema" Foreground="{ThemeResource MutedTextBrush}" FontSize="10"/></StackPanel></Border>
                </Grid>
                <Grid Grid.Row="4" ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="13"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8F1;" Foreground="{ThemeResource AccentIndigoBrush}" FontSize="16"/><TextBlock Text="Acciones rápidas" FontWeight="SemiBold" FontSize="14"/></StackPanel><TextBlock Text="Gestiona la protección sin abandonar el panel principal." Foreground="{ThemeResource MutedTextBrush}" FontSize="11"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Tag="apps" Click="NavButton_Click" Style="{StaticResource RoundedDialogButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE710;" FontSize="12"/><TextBlock Text="Gestionar aplicaciones" FontSize="11"/></StackPanel></Button><Button Grid.Column="1" Click="AddVaultButton_Click" Style="{StaticResource RoundedPrimaryButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE710;" FontSize="12"/><TextBlock Text="Nueva bóveda" FontSize="11"/></StackPanel></Button></Grid></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="10"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9D2;" Foreground="{ThemeResource AccentIndigoBrush}" FontSize="16"/><TextBlock Text="Estado del sistema" FontWeight="SemiBold" FontSize="14"/></StackPanel><TextBlock x:Name="DashboardSystemDetailText" Text="La comprobación detallada está disponible en Diagnóstico." Foreground="{ThemeResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap"/><Button Tag="diagnostics" Click="NavButton_Click" Style="{StaticResource RoundedDialogButtonStyle}" HorizontalAlignment="Left" Padding="11,6"><TextBlock Text="Abrir diagnóstico" FontSize="11"/></Button></StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="AppsView">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Padding="14,12" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid MaxWidth="440" HorizontalAlignment="Left">
                        <TextBox x:Name="SearchBox" PlaceholderText="Buscar aplicaciones" TextChanged="SearchBox_TextChanged" Padding="36,8,10,8" CornerRadius="8"/>
                        <FontIcon Glyph="&#xE721;" Foreground="{ThemeResource MutedTextBrush}" FontSize="13" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <ToggleButton x:Name="EnabledOnlyButton" Grid.Column="1" Content="Activas" Click="FilterButton_Click" Style="{StaticResource RoundedFilterToggleButtonStyle}"/>
                    <Button Grid.Column="2" AutomationProperties.Name="Añadir" Click="AddApplicationButton_Click" Style="{StaticResource RoundedPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE710;" FontSize="12"/><TextBlock Text="Añadir" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CategoryChipsPanel" Orientation="Horizontal" Spacing="6" />
                    </ScrollViewer>
                    <Button Grid.Column="1" x:Name="GroupActionsButton" CornerRadius="8" Padding="10,6" Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" Foreground="{ThemeResource PrimaryTextBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Acciones de grupo" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="9" VerticalAlignment="Center" Foreground="{ThemeResource MutedTextBrush}"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="LockGroupMenuItem" Text="Bloquear grupo seleccionado" Click="LockGroup_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="EnableGroupMenuItem" Text="Activar protección del grupo" Click="EnableGroup_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="DisableGroupMenuItem" Text="Desactivar protección del grupo" Click="DisableGroup_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <Border Grid.Row="3" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Padding="16,0" ColumnSpacing="12" Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="APLICACIÓN" Foreground="{ThemeResource SubtleTextBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" CharacterSpacing="70"/>
                            <TextBlock Grid.Column="2" Text="ACCESO" Foreground="{ThemeResource SubtleTextBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" CharacterSpacing="70"/>
                            <TextBlock Grid.Column="3" Text="ACTIVA" Foreground="{ThemeResource SubtleTextBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" CharacterSpacing="70"/>
                        </Grid>
                        <ListView x:Name="ApplicationsList" Grid.Row="1" ItemsSource="{x:Bind VisibleApps, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4,1"/><Setter Property="CornerRadius" Value="7"/></Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProtectedApplication">
                                    <Grid Padding="12,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="7" Background="{ThemeResource ControlSurfaceBrush}"><Image Source="{x:Bind IconSource, Mode=OneWay}" Stretch="Uniform" Margin="5"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Style="{StaticResource TruncatedTextStyle}"/>
                                                <Border Background="{ThemeResource ControlSurfaceBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind CategoryLabel, Mode=OneWay}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource AccentIndigoBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Path}" Foreground="{ThemeResource SubtleTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Style="{StaticResource TruncatedTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind AccessLabel, Mode=OneWay}" Foreground="{ThemeResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Style="{StaticResource TruncatedTextStyle}"/>
                                            <TextBlock Text="{x:Bind ScheduleSummary, Mode=OneWay}" Foreground="{ThemeResource SubtleTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Style="{StaticResource TruncatedTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="3" IsOn="{x:Bind IsEnabled, Mode=OneWay}" Toggled="RuleToggle_Toggled" OnContent="" OffContent="" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                                            <Button Content="&#xE70F;" Style="{StaticResource IconButtonStyle}" Click="EditRule_Click" ToolTipService.ToolTip="Editar" AutomationProperties.Name="Editar protección"/>
                                            <Button Content="&#xE72E;" Style="{StaticResource IconButtonStyle}" Click="LockRule_Click" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" ToolTipService.ToolTip="Bloquear esta aplicación" AutomationProperties.Name="Bloquear aplicación"/>
                                            <Button Content="&#xE74D;" Style="{StaticResource IconButtonStyle}" Click="DeleteRule_Click" ToolTipService.ToolTip="Eliminar" AutomationProperties.Name="Eliminar protección"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyState" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                            <FontIcon Glyph="&#xE72E;" FontSize="25" Foreground="{ThemeResource SubtleTextBrush}"/>
                            <TextBlock Text="No hay aplicaciones protegidas" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="Pulsa Añadir para seleccionar una aplicación, un ejecutable o un script." Foreground="{ThemeResource MutedTextBrush}" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="VaultsView" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Padding="14,12" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Contenedores cifrados con contraseña propia" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="Consulta archivos sin crear una copia completa en el disco o abre la bóveda para editar y guardar cambios." Foreground="{ThemeResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Convertir carpeta" Click="AddFolderButton_Click" Style="{StaticResource RoundedDialogButtonStyle}" CornerRadius="8" ToolTipService.ToolTip="Convertir una carpeta en una bóveda cifrada"/>
                    <Button Grid.Column="2" Content="Limpiar ausentes" Click="CleanupMissingVaultReferences_Click" Style="{StaticResource RoundedDialogButtonStyle}" CornerRadius="8" ToolTipService.ToolTip="Quitar de la lista las bóvedas cuyo archivo y copia de recuperación ya no existen"/>
                    <Button Grid.Column="3" Content="Importar" Click="ImportVaultButton_Click" Style="{StaticResource RoundedDialogButtonStyle}" CornerRadius="8"/>
                    <Button Grid.Column="4" AutomationProperties.Name="Nueva bóveda" Click="AddVaultButton_Click" Style="{StaticResource RoundedPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE710;" FontSize="12"/><TextBlock x:Name="NewVaultLabel" Text="Nueva bóveda" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                </Grid>
                </Border>
                <Border x:Name="VaultRecoveryPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed"
                        BorderBrush="{ThemeResource AccentIndigoBrush}" BorderThickness="1" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Padding="14,0" ColumnSpacing="8" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource AccentIndigoBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="Recuperación pendiente" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="VaultRecoveryCountText" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Actualizar" Click="RefreshVaultRecoveryButton_Click"
                                    Style="{StaticResource RoundedDialogButtonStyle}" CornerRadius="7" Padding="10,4" FontSize="10"/>
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind VaultRecoveryItems, Mode=OneWay}" SelectionMode="None" MaxHeight="142"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4,1"/><Setter Property="CornerRadius" Value="7"/></Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:VaultRecoveryItem">
                                    <Grid Padding="10,7" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="176"/></Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="7" Background="{ThemeResource ControlSurfaceBrush}">
                                            <FontIcon Glyph="&#xE777;" FontSize="13" Foreground="{ThemeResource AccentIndigoBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind DisplayName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Style="{StaticResource TruncatedTextStyle}"/>
                                            <TextBlock Text="{x:Bind DetailLabel}" Foreground="{ThemeResource MutedTextBrush}" FontSize="9" TextTrimming="CharacterEllipsis" Style="{StaticResource TruncatedTextStyle}"/>
                                            <TextBlock Text="{x:Bind WorkingDirectory}" Foreground="{ThemeResource SubtleTextBrush}" FontSize="9" TextTrimming="CharacterEllipsis" Style="{StaticResource TruncatedTextStyle}"
                                                       ToolTipService.ToolTip="{x:Bind WorkingDirectory}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind StatusLabel}" Foreground="{ThemeResource AccentIndigoBrush}" FontSize="9"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="Guardar y bloquear" Click="RecoverVaultWork_Click" IsEnabled="{x:Bind CanRecover}"
                                                    Style="{StaticResource RoundedPrimaryButtonStyle}" CornerRadius="7" Padding="9,5" FontSize="9"/>
                                            <Button Content="&#xE838;" Click="OpenVaultRecoveryFolder_Click" Style="{StaticResource IconButtonStyle}"
                                                    ToolTipService.ToolTip="Abrir carpeta de trabajo" AutomationProperties.Name="Abrir carpeta de recuperación"/>
                                            <Button Content="&#xE74D;" Click="DiscardVaultRecovery_Click" Style="{StaticResource IconButtonStyle}"
                                                    ToolTipService.ToolTip="Descartar trabajo" AutomationProperties.Name="Descartar carpeta de recuperación"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Margin="0,10,0,0" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Padding="16,0" ColumnSpacing="12" Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="124"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="BÓVEDA" Foreground="{ThemeResource SubtleTextBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" CharacterSpacing="70"/>
                            <TextBlock Grid.Column="2" Text="UBICACIÓN DEL ARCHIVO" Foreground="{ThemeResource SubtleTextBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" CharacterSpacing="70"/>
                            <TextBlock Grid.Column="3" Text="ESTADO" Foreground="{ThemeResource SubtleTextBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" CharacterSpacing="70"/>
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind Vaults, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4,1"/><Setter Property="CornerRadius" Value="7"/></Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:VaultContainer">
                                    <Grid Padding="12,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="124"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="7" Background="{ThemeResource ControlSurfaceBrush}"><FontIcon Glyph="&#xE72E;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource AccentIndigoBrush}" FontSize="15"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Style="{StaticResource TruncatedTextStyle}"/><TextBlock Text="{x:Bind Description}" Foreground="{ThemeResource SubtleTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Style="{StaticResource TruncatedTextStyle}"/></StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{x:Bind VaultFilePath, Mode=OneWay}" Foreground="{ThemeResource MutedTextBrush}" FontSize="12"
                                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind VaultFilePath, Mode=OneWay}"/>
                                            <TextBlock Text="{x:Bind SizeLabel, Mode=OneWay}" Foreground="{ThemeResource SubtleTextBrush}" FontSize="12"/>
                                            <TextBlock Text="{x:Bind ScheduledBackupLabel, Mode=OneWay}" Foreground="{ThemeResource SubtleTextBrush}" FontSize="9" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ScheduledBackupDetail, Mode=OneWay}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{x:Bind StatusLabel, Mode=OneWay}" Foreground="{ThemeResource AccentIndigoBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind StatusLabel, Mode=OneWay}"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                                            <Button Content="&#xE838;" Style="{StaticResource IconButtonStyle}" Click="OpenVault_Click" IsEnabled="{x:Bind CanOpen, Mode=OneWay}" ToolTipService.ToolTip="Abrir bóveda" AutomationProperties.Name="Abrir bóveda"/>
                                            <Button Content="&#xE72E;" Style="{StaticResource IconButtonStyle}" Click="LockVault_Click" IsEnabled="{x:Bind CanLock, Mode=OneWay}" ToolTipService.ToolTip="Guardar cambios y bloquear" AutomationProperties.Name="Guardar y bloquear bóveda"/>
                                            <Button Content="&#xE712;" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Más acciones de bóveda" AutomationProperties.Name="Más acciones de bóveda">
                                                <Button.Flyout>
                                                    <MenuFlyout Opening="VaultActionsFlyout_Opening">
                                                        <MenuFlyoutItem Text="Ver historial" CommandParameter="{Binding}" Click="ShowVaultActivity_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Comprobar integridad" CommandParameter="{Binding}" Click="VerifyVaultIntegrity_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D2;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Copias programadas" CommandParameter="{Binding}" Click="ManageScheduledVaultBackups_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Copia de recuperación" CommandParameter="{Binding}" Click="ManageVaultBackup_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                                        <MenuFlyoutSeparator/>
                                                        <MenuFlyoutItem Text="Editar bóveda" CommandParameter="{Binding}" Click="EditVault_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Quitar de la lista" CommandParameter="{Binding}" Click="RemoveVault_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyVaultsState" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                            <FontIcon Glyph="&#xE72E;" FontSize="25" Foreground="{ThemeResource SubtleTextBrush}"/>
                            <TextBlock Text="No hay bóvedas cifradas" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="Crea un contenedor nuevo o importa uno existente." Foreground="{ThemeResource MutedTextBrush}" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ActivityView" Visibility="Collapsed">
                <Grid.Resources>
                    <Style x:Key="ActivityFilterCardStyle" TargetType="ToggleButton">
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="CornerRadius" Value="9"/>
                        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="CardSurface"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="CardSurface.Background" Value="{ThemeResource FilterCardHoverBrush}"/></VisualState.Setters></VisualState>
                                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="CardSurface.Background" Value="{ThemeResource FilterCardPressedBrush}"/></VisualState.Setters></VisualState>
                                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="CardSurface.Opacity" Value="0.45"/></VisualState.Setters></VisualState>
                                            </VisualStateGroup>
                                            <VisualStateGroup x:Name="CheckStates">
                                                <VisualState x:Name="Unchecked"/>
                                                <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="CardSurface.Background" Value="{ThemeResource PrimaryActionBrush}"/><Setter Target="CardSurface.BorderBrush" Value="{ThemeResource AccentIndigoBrush}"/><Setter Target="CardContent.Foreground" Value="{ThemeResource PrimaryActionTextBrush}"/></VisualState.Setters></VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <ContentPresenter x:Name="CardContent"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          Padding="{TemplateBinding Padding}"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalContentAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Padding="12" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ActivitySearchBox"
                             PlaceholderText="Buscar en el historial"
                             CornerRadius="8"
                             TextChanged="ActivitySearchBox_TextChanged"/>
                    <TextBlock x:Name="ActivityCountText" Grid.Column="1" Foreground="{ThemeResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0"/>
                    <Button x:Name="ExportActivityButton" Grid.Column="2" Style="{StaticResource RoundedDialogButtonStyle}" CornerRadius="8" AutomationProperties.Name="Exportar actividad" Click="ExportActivityButton_Click" ToolTipService.ToolTip="Exportar los eventos visibles">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xEDE1;" FontSize="12"/>
                            <TextBlock x:Name="ExportActivityLabel" Text="Exportar…"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearActivityButton" Grid.Column="3" Style="{StaticResource RoundedDialogButtonStyle}" CornerRadius="8" AutomationProperties.Name="Limpiar historial" Click="ClearActivityButton_Click" ToolTipService.ToolTip="Limpiar historial">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                            <TextBlock x:Name="ClearActivityLabel" Text="Limpiar"/>
                        </StackPanel>
                    </Button>
                </Grid>
                </Border>
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ActivityEvents24hFilterButton" Tag="recent" Style="{StaticResource ActivityFilterCardStyle}" Click="ActivityFilterCard_Click" IsChecked="True" ToolTipService.ToolTip="Mostrar eventos de las últimas 24 horas" AutomationProperties.Name="Filtrar eventos de las últimas 24 horas">
                        <StackPanel Spacing="1"><TextBlock x:Name="ActivityEvents24hLabel" Text="EVENTOS · 24 H" FontSize="9" FontWeight="SemiBold"/><TextBlock x:Name="ActivityEvents24hText" Text="0" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ActivityBlockedFilterButton" Grid.Column="1" Tag="blocked" Style="{StaticResource ActivityFilterCardStyle}" Click="ActivityFilterCard_Click" ToolTipService.ToolTip="Mostrar bloqueos" AutomationProperties.Name="Filtrar bloqueos">
                        <StackPanel Spacing="1"><TextBlock x:Name="ActivityBlockedLabel" Text="BLOQUEOS" FontSize="9" FontWeight="SemiBold"/><TextBlock x:Name="ActivityBlocked24hText" Text="0" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ActivityFailedPasswordsFilterButton" Grid.Column="2" Tag="failed" Style="{StaticResource ActivityFilterCardStyle}" Click="ActivityFilterCard_Click" ToolTipService.ToolTip="Mostrar contraseñas fallidas" AutomationProperties.Name="Filtrar contraseñas fallidas">
                        <StackPanel Spacing="1"><TextBlock x:Name="ActivityFailedPasswordsLabel" Text="CONTRASEÑAS FALLIDAS" FontSize="9" FontWeight="SemiBold"/><TextBlock x:Name="ActivityFailedPasswords24hText" Text="0" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ActivityAlertsFilterButton" Grid.Column="3" Tag="error" Style="{StaticResource ActivityFilterCardStyle}" Click="ActivityFilterCard_Click" ToolTipService.ToolTip="Mostrar avisos y errores" AutomationProperties.Name="Filtrar avisos y errores">
                        <StackPanel Spacing="1"><TextBlock x:Name="ActivityAlertsLabel" Text="AVISOS Y ERRORES" FontSize="9" FontWeight="SemiBold"/><TextBlock x:Name="ActivityAlerts24hText" Text="0" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                    </ToggleButton>
                </Grid>
                <Border Grid.Row="4" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" Padding="5">
                    <Grid>
                        <ListView ItemsSource="{x:Bind Activity, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="3,1"/><Setter Property="CornerRadius" Value="7"/></Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate><DataTemplate x:DataType="models:ActivityEntry">
                                <Grid Padding="10,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="92"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="7" Background="{ThemeResource ControlSurfaceBrush}">
                                        <FontIcon Glyph="{x:Bind Glyph}" Foreground="{Binding Kind, Converter={StaticResource ActivityKindBrushConverter}}" FontSize="12"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind TimeLabel}" Foreground="{ThemeResource SubtleTextBrush}" FontFamily="Cascadia Mono" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind AppName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Style="{StaticResource TruncatedTextStyle}"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind Message}" Foreground="{ThemeResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Style="{StaticResource TruncatedTextStyle}"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind KindLabel}" Foreground="{Binding Kind, Converter={StaticResource ActivityKindBrushConverter}}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EmptyActivityText" Text="Aún no hay actividad" Foreground="{ThemeResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="DiagnosticsView" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Padding="18,16" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="9" Background="{ThemeResource ControlSurfaceBrush}">
                            <FontIcon x:Name="DiagnosticsSummaryIcon" Glyph="&#xE946;" Foreground="{ThemeResource AccentIndigoBrush}" FontSize="16"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="DiagnosticsSummaryText" Text="Diagnóstico todavía no ejecutado" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="DiagnosticsSummaryDetail" Text="Comprueba los componentes de protección sin modificar el sistema." Foreground="{ThemeResource MutedTextBrush}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RepairDiagnosticsButton" Content="Reparar protección" Style="{StaticResource RoundedDialogButtonStyle}" CornerRadius="8" Visibility="Collapsed" Click="RepairDiagnosticsButton_Click"/>
                            <Button x:Name="RunDiagnosticsButton" Content="Comprobar ahora" Style="{StaticResource RoundedPrimaryButtonStyle}" Click="RunDiagnosticsButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" Padding="5">
                    <Grid>
                        <ListView ItemsSource="{x:Bind Diagnostics, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="3,1"/><Setter Property="CornerRadius" Value="7"/></Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DiagnosticResult">
                                    <Grid Padding="12,9" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="7" Background="{ThemeResource ControlSurfaceBrush}">
                                            <FontIcon Glyph="{x:Bind Glyph}" Foreground="{ThemeResource AccentIndigoBrush}" FontSize="13"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Detail}" Foreground="{ThemeResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind StatusLabel}" Foreground="{ThemeResource SubtleTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EmptyDiagnosticsText" Text="Pulsa Comprobar ahora para analizar ProtectedApp" Foreground="{ThemeResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- No fixed minimum here: after the sidebar was widened, 960 px caused this
                 view to overflow smaller windows even though its controls can reflow. -->
            <Grid x:Name="SettingsView" Visibility="Collapsed" MaxWidth="1140" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Padding="20,16" CornerRadius="14" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="7">
